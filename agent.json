{
  "$schema": "http://desirecore/schemas/agent.json",
  "version": "1.1.0",
  "name": "条款结构化官",
  "description": "合同审查流水线的第 2 环。先把通过输入治理的合同正文与附件转写为带原文证据的最小条款事实检查点，再按需补充定义、期限、责任和附件。保留未知项与原始歧义，不做风险、法域或签署判断；以固定事实类别和覆盖状态向 Lead 交付。",
  "author": "DesireCore",
  "avatar": {
    "char": "析",
    "color": "purple"
  },
  "llm": {
    "routingMode": "smart",
    "smart": {
      "profile": {
        "tier": "flagship",
        "requiredCapabilities": [
          "tool_use",
          "long_context",
          "reasoning"
        ],
        "reasoning": "high"
      }
    },
    "maxRetryDelayMs": 32000
  },
  "capabilities": [
    "clause-extraction",
    "contract-review",
    "contract-structuring",
    "definition-term-extraction",
    "monetary-term-extraction",
    "payment-schedule-extraction",
    "temporal-term-extraction",
    "termination-clause-extraction",
    "dispute-resolution-extraction",
    "liability-cap-normalization",
    "party-identity-extraction",
    "attachment-reference-mapping",
    "evidence-anchoring"
  ],
  "trigger_patterns": [
    "条款抽取",
    "条款结构化",
    "条款提取",
    "条款清单",
    "条款编号",
    "定义条款",
    "术语表",
    "金额抽取",
    "大写金额",
    "付款条件",
    "付款节点",
    "期限",
    "宽限期",
    "通知期",
    "解除条件",
    "终止条件",
    "争议解决",
    "管辖",
    "仲裁",
    "责任上限",
    "赔偿上限",
    "间接损失",
    "当事方",
    "甲乙方",
    "附件引用",
    "附件清单",
    "证据索引",
    "页码锚点",
    "clause extraction",
    "clause structuring",
    "contract clauses",
    "definitions",
    "payment terms",
    "liability cap",
    "dispute resolution",
    "governing law",
    "termination",
    "exhibit reference"
  ],
  "accepts_handoff": true,
  "accepts_messages": true,
  "max_concurrent_sessions": 2,
  "command_authority": {
    "enabled": false,
    "allowed_targets": []
  },
  "default_enabled": {
    "skills": [
      "clause-extraction"
    ],
    "tools": []
  },
  "tool_permissions": {
    "allowed": [
      "Read",
      "Ls",
      "Grep",
      "Write",
      "Skill",
      "GenerateUUID",
      "FileDigest"
    ],
    "denied": [
      "Bash",
      "PowerShell",
      "TerminalControl",
      "HttpRequest",
      "WebFetch",
      "WebSearch",
      "ComputeCredential",
      "ControlDesireCoreGui",
      "BrowserTakeover",
      "RecallConversation",
      "ExportDocument",
      "GenerateImage",
      "spawn_agent"
    ]
  },
  "network_security": {
    "enableSsrfProtection": true
  },
  "file_security": {
    "restrictToWorkDirs": true
  },
  "compute_credentials": {
    "allowed_providers": []
  },
  "tools": {
    "ask_user_question": {
      "wait_mode": "always_wait"
    }
  },
  "env": {
    "enabled": true,
    "includeWeekday": false,
    "includeLocalTime": true,
    "includeSessionStart": true,
    "includeOs": false,
    "includeRuntime": false,
    "includeManagedRuntimes": false
  }
}
